#include <unistd.h>
#include <fcntl.h>
#include<string.h>

#define size 1000
char buf[size];

int echo_main(int argc, char *argv[]) {
    
    for(int i =1; i < argc; i++)
    {
        write(1, argv[i], strlen(argv[i]));
        if (i < argc - 1)
        {
            write(1 , " ", 1);
        }
    }
    
    write(1, "\n", 1);
    return 0;
}